{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OnPeople",
  "version": "0.30.0",
  "identifier": "com.userinner.onpeople",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost https://api.aibro.vip wss://api.aibro.vip; style-src 'self' 'unsafe-inline'; script-src 'self'; img-src 'self' asset: data: blob:; font-src 'self' data:; frame-src 'self' data: blob:; worker-src 'self' blob:",
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "resources": {
      "../.embedded-runtime/": ".embedded-runtime/"
    },
    "icon": [
      "../assets/onpeople-app-icon-256.png",
      "../assets/OnPeople.icns",
      "../assets/OnPeople.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "hardenedRuntime": true,
      "signingIdentity": "Developer ID Application: Happy Metaverse Internet Technology Co., Limited (6K4S66PVRQ)",
      "entitlements": "../build/entitlements.mac.plist"
    },
    "windows": {
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.digicert.com",
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["onpeople"]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJGNUMzMTg3QTVBMEVBRDIKUldUUzZxQ2xoekZjdjRRSW5GMjJFaW93dzVjcU9UbVlrdkFGQ3kzeGhldSs4RHA4bGtYVlZBZzAK",
      "endpoints": [
        "https://aibro.vip/onpeople/update/{{target}}/{{arch}}/latest.json"
      ]
    }
  }
}
